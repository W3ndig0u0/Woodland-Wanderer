  m_Script: {fileID: 11500000, guid: e524023affb6dd5409479d50c074d239, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue: {fileID: 1766984525}
  playerCoins: {fileID: 813193505}
  lines:
  - 'Greetings, young one. I see you have an interest in learning how to fight. Very
    well, I will teach you.  '
  - 'First, let''s start with the basics. You have two types of attacks: a light
    attack and a heavy attack. To perform a light attack, press the "J" key. For
    a heavy attack, press the "K" key.  '
  - 'Light attacks are quick and consume less energy, while heavy attacks are slower
    but deal more damage. It''s important to know when to use each type of attack. '
  - 'Now, there''s a goblin in front of us. This is a perfect opportunity for you
    to practice. Go ahead and attack it. Remember to dodge its attacks by moving
    left or right.  '
  - 'With practice and determination, you''ll become a formidable warrior. Are you
    ready to continue your training, young one?    '
  questRecive: 0
  tutorialMode: 0
  isQuestGiver: 0
  questComplete: 0
