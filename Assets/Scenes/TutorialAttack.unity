  m_Name: 
  m_EditorClassIdentifier: 
  dialogue: {fileID: 1766984525}
  playerCoins: {fileID: 813193505}
  lines:
  - 'Greetings, young one. Let me tell you a cautionary tale. Once there was an adventurer
    who faced a witch with a goblin army. Unfortunately, he lost the battle and was
    cursed to run forever without rest.  '
  - 'The adventurer learned the hard way that it''s important to be prepared for
    any situation. He was overconfident and didn''t take the witch''s power seriously.
    He paid the price for his mistake.  '
  - 'Remember, young one, danger can come from unexpected places. Always be vigilant
    and prepared. And if you do find yourself in a difficult situation, don''t give
    up hope. With determination and perseverance, anything is possible.    '
  questRecive: 0
  tutorialMode: 0
  isQuestGiver: 0
  questComplete: 0
  playerRecivedQuest: 0
  coinsToCollect: 0
  enemiesToDefeat: 0
  bossHp: {fileID: 0}
  endLevel: {fileID: 1250026158}
